#!/usr/bin/env node

var version = '0.5.9';
var fs = require('fs');
var { parseArgs } = require('node:util');
var ect = require('..');

var usage = 'ECT template compiler ' + version + '\n\nUsage: ect source [destination]\n\nOptions:\n  -o, --open   Open tag (default: <%)\n  -c, --close  Closing tag (default: %>)\n  -h, --help   Print help and exit';

var parsed;
try {
	parsed = parseArgs({
		options: {
			open: { type: 'string', short: 'o', default: '<%' },
			close: { type: 'string', short: 'c', default: '%>' },
			help: { type: 'boolean', short: 'h', default: false }
		},
		allowPositionals: true
	});
} catch (err) {
	console.error(err.message);
	console.error(usage);
	process.exit(1);
}

var args = parsed.positionals;
var values = parsed.values;

var renderer = ect({ open: values.open, close: values.close });

var compile = function (content) {
	try {
		var compiled = renderer.compile(content);
		if (args[1]) {
			fs.writeFileSync(args[1], '(' + compiled.toString() + ');');
		} else {
			console.log('(' + compiled.toString() + ');');
		}
	} catch (err) {
		console.error(err.message);
		process.exit(1);
	}
};

var read = function () {
	var stats;
	try {
		stats = fs.statSync(args[0]);
	} catch (err) {
		console.error(err.message);
		process.exit(1);
	}
	if (stats.isDirectory()) {
		console.error('Directory compilation is not supported');
		process.exit(1);
	} else {
		var file = fs.readFileSync(args[0]);
		compile(file.toString());
	}
};

if (values.help || !args.length) {
	console.log(usage);
} else {
	read();
}
